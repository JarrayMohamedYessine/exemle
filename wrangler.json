{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "superstudent-worker",
  "main": "artifacts/superstudent/src/worker/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "artifacts/superstudent/dist",
    "binding": "ASSETS"
  },
  "analytics_engine_datasets": [
    {
      "binding": "abc",
      "dataset": "SuperStudent"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "vars": {
    "OWNER_EMAIL": "learningmyj20@gmail.com"
  }
}
