# Base44 sandbox defaults — placeholders only, safe to commit.
# The platform-managed /run/base44/app.env is listed AFTER this file in compose,
# so any real value you add in the dashboard always wins over these.

# Local libSQL (Turso-compatible) server started by docker-compose.base44.yml.
TURSO_DATABASE_URL=http://db:8080
TURSO_AUTH_TOKEN=

# Secret required by POST /api/setup/owner (first owner bootstrap). Local dev value.
SETUP_SECRET=superstudent-local-dev-setup-secret

# Optional integrations (left empty on purpose; the app runs without them).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CF_ACCOUNT_ID=
AE_SQL_API_TOKEN=
