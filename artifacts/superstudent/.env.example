# ==============================================================================
# SuperStudent.TN — Environment Variables & Secrets Template
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# 1. Owner & Core Auth Configuration
OWNER_EMAIL=learningmyj20@gmail.com
SETUP_SECRET=YOUR_SUPERSTUDENT_OWNER_SETUP_SECRET_HERE

# 2. Turso LibSQL Database Configuration (Database name: superstudent)
TURSO_DATABASE_URL=libsql://superstudent-yourorg.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# 3. Cloudflare Analytics Engine & Worker Configuration
CF_ACCOUNT_ID=your_cloudflare_account_id_here
AE_SQL_API_TOKEN=your_analytics_engine_api_token_here

# 4. Storage & Private Backup Providers
# Catbox: Primary public upload endpoint (https://catbox.moe/user/api.php)
CATBOX_USER_HASH=optional_user_hash_if_registered

# Buzzheavier: Fallback upload provider (https://buzzheavier.com/api/upload)
BUZZHEAVIER_API_KEY=optional_buzzheavier_api_key

# Telegram: Strictly private archival backup (never exposed to public frontend)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_private_backup_channel_or_chat_id
